    <!-- Mirror - Device picker (comps 01/03) -->
    <string name="mirror_picker_title">Choose what to mirror</string>
    <string name="mirror_picker_subtitle">Switch platform or device any time from the toolbar.</string>
    <string name="mirror_section_platform">PLATFORM</string>
    <string name="mirror_section_source">SOURCE</string>
    <!-- The listing command is an ARGUMENT, not copy: iOS has no adb to run. -->
    <string name="mirror_source_summary">%1$d found · %2$s</string>
    <string name="mirror_group_physical">Physical device</string>
    <string name="mirror_group_emulator">Virtual devices</string>
    <string name="mirror_row_boot">Boot</string>
    <string name="mirror_row_running">Running</string>
    <string name="mirror_row_shut_down">shut down</string>
    <string name="mirror_hint_keys">↑↓ select · ↵ start</string>
    <string name="mirror_action_start">Start mirroring</string>
    <!-- Dismisses the picker. Shown only once a device has been chosen, which is also the
         only time esc closes the panel (A11Y-4). -->
    <string name="mirror_action_close">Close</string>

    <!-- Mirror - No signal / waiting (comp 02) -->
    <string name="mirror_no_signal_label">NO SIGNAL</string>
    <string name="mirror_connecting_label">Starting the capture loop…</string>
    <string name="mirror_waiting_title">Waiting for an Android device</string>
    <string name="mirror_waiting_no_avds">No AVDs installed</string>
    <!-- Explicit-CTA wording (survey Q1 option A). Never the comp-02 auto-start sentence:
         the picker ships a Start mirroring button, so nothing starts on its own. -->
    <string name="mirror_waiting_subtitle">Plug one in or boot an emulator, then press Start mirroring.</string>
    <string name="mirror_waiting_step_usb">Plug in a phone with USB debugging on and accept the prompt.</string>
    <string name="mirror_waiting_step_emulator">Or boot an emulator</string>
    <string name="mirror_waiting_footer">adb devices · polling every 2 s</string>

    <!-- iOS half of the waiting stage. Same split as the mirror_error_*_ios block below:
         the stage picks the set by the selected platform, because an iOS bench has no USB
         debugging prompt, no AVDs and no adb to poll. -->
    <string name="mirror_waiting_title_ios">Waiting for an iOS simulator</string>
    <string name="mirror_waiting_subtitle_ios">Boot a simulator or connect an iPhone, then press Start mirroring.</string>
    <string name="mirror_waiting_step_usb_ios">Connect an iPhone and tap Trust on the prompt.</string>
    <string name="mirror_waiting_step_emulator_ios">Or boot a simulator</string>
    <string name="mirror_waiting_footer_ios">xcrun simctl · polling every 2 s</string>
    <string name="mirror_waiting_no_simulators">No simulators found</string>

    <!-- Mirror - Status line and tool detection -->
    <string name="mirror_status_detecting">Detecting tools…</string>
    <string name="mirror_status_waiting">Waiting for device…</string>
    <string name="mirror_status_tool_missing">adb not found</string>
    <!-- Mirror - status line per discovery error state, from the design's own STATUS table.
    Machine output, so these read as diagnostics rather than prose. -->
    <string name="mirror_status_no_device_attached">adb devices → %1$d attached</string>
    <string name="mirror_status_awaiting_choice">%1$d devices attached — waiting for choice</string>
    <string name="mirror_status_poll_failed">adb not responding, retrying…</string>
    <!-- The two iOS blocked states. Both pair with a Blocked dot, and neither may name adb. -->
    <string name="mirror_status_simulator_not_booted">no simulator booted</string>
    <string name="mirror_status_device_not_trusted">iPhone not trusted yet</string>
    <string name="mirror_status_latency_placeholder">latency —</string>
    <string name="mirror_status_polling_hint">polling</string>
    <string name="mirror_tool_not_found">not found</string>

    <!-- Mirror - Annotations on a frozen frame (comps 04/05) -->
    <string name="mirror_annotation_placeholder">What's wrong here?</string>
    <string name="mirror_annotation_save_hint">⏎ save</string>
    <string name="mirror_annotation_empty_comment">No comment yet</string>
    <string name="mirror_annotation_notes_empty">Drag on the frame to stage an annotation.</string>
    <!-- The close control of the popover deletes the annotation (FR-8), so its accessibility
         label has to say so rather than announcing Close. -->
    <string name="mirror_annotation_delete">Delete annotation</string>
    <string name="mirror_action_resume_live">Resume live</string>

    <!-- Mirror - Actionable error cards. Copy is the design's verbatim err-adb / err-nodevice /
         err-multi text (inputs/design-error-states.md), except err-multi's second sentence:
         the design promises "Rectify remembers it until you quit", which is false against
         sessionDeviceId (nulled by onSessionLost, selectPlatform and stopSession), so the
         shipped sentence claims only the session. Same rule as mirror_waiting_subtitle. -->
    <string name="mirror_error_tool_missing_title">adb isn't on your PATH</string>
    <string name="mirror_error_tool_missing_body">Rectify uses Android platform-tools to find devices. Install them, or point Rectify at an adb you already have.</string>
    <string name="mirror_error_no_device_title">No Android device detected</string>
    <string name="mirror_error_no_device_body">adb is running but sees nothing. On the phone, turn on USB debugging and tap Allow on the prompt.</string>
    <!-- No design state exists for a failed poll (it is Android-only). The copy has to say adb
         itself did not answer, never that the bench is empty, or the card misreports (FR-32). -->
    <string name="mirror_error_poll_failed_title">adb stopped responding</string>
    <string name="mirror_error_poll_failed_body">The device poll never came back, so nothing is known about what is attached. Retry, or read what adb reported in the footer.</string>
    <string name="mirror_error_multiple_title">%1$d devices connected</string>
    <string name="mirror_error_multiple_body">Pick one to mirror. Rectify keeps using it for this session.</string>
    <string name="mirror_error_action_locate_adb">Locate adb…</string>
    <string name="mirror_error_action_retry">Retry</string>
    <string name="mirror_error_action_restart_adb">Restart adb</string>
    <string name="mirror_error_action_boot_emulator">Boot emulator instead</string>
    <string name="mirror_error_action_mirror_device">Mirror %1$s</string>
    <!-- Mirror - the two iOS error cards the design drew as err-sim and err-trust. Wired by
         F-10. The shared four above keep their adb wording for Android only; their iOS
         wording is the *_ios block below, which the projection selects by platform. -->
    <string name="mirror_error_simulator_not_booted_title">No simulator is running</string>
    <string name="mirror_error_simulator_not_booted_body">Xcode knows about your simulators but none of them is booted. Boot one, or pick a different simulator.</string>
    <string name="mirror_error_device_not_trusted_title">This iPhone hasn't been trusted</string>
    <string name="mirror_error_device_not_trusted_body">Unlock the iPhone and tap Trust on the prompt, then retry. You can use a simulator instead.</string>
    <string name="mirror_error_action_boot_simulator">Boot simulator</string>
    <string name="mirror_error_action_choose_another">Choose another</string>
    <string name="mirror_error_action_use_simulator">Use simulator</string>
    <!-- The err-trust primary. The apostrophe and the em dash are LITERAL: Compose Resources
         is not AAPT, so an escaped \' would render the backslash. -->
    <string name="mirror_error_action_trusted_retry">I've tapped Trust — retry</string>

    <!-- Mirror - the iOS wording of the SHARED cards. A missing xcrun and a missing adb are
         the same card with different copy; suppressing these on iOS would hand the user a
         blank stage for conditions an iOS bench genuinely reaches. No line here may name adb:
         there is no daemon to restart and no platform-tools to install. -->
    <string name="mirror_error_tool_missing_title_ios">Xcode command line tools aren't on your PATH</string>
    <string name="mirror_error_tool_missing_body_ios">Rectify uses xcrun and simctl to find simulators. Install Xcode, then run xcode-select --install.</string>
    <string name="mirror_error_no_device_title_ios">No iOS device or simulator detected</string>
    <string name="mirror_error_no_device_body_ios">xcrun is running but sees nothing. Boot a simulator, or connect an iPhone and tap Trust on the prompt.</string>
    <string name="mirror_error_poll_failed_title_ios">xcrun stopped responding</string>
    <string name="mirror_error_poll_failed_body_ios">The device poll never came back, so nothing is known about what is attached. Retry, or read what the footer reports.</string>

    <!-- Mirror - Stream-drop banner (FR-24 / AC-29). The design's verbatim copy, which has one
         detail sentence and no singular variant: the count is always stated, zero included. -->
    <string name="mirror_banner_stream_dropped">Stream dropped</string>
    <string name="mirror_banner_annotations_kept">Your %1$d annotations are kept on the frozen frame.</string>
    <string name="mirror_banner_reconnect">Reconnect</string>
    <!-- Mirror - Measure mode (FR-36..FR-45 / AC-10 / AC-67 / AC-69 / AC-72). Only the panel's
         CHROME is localised: the node id, the five figures, the finding and the ⌥ note line are
         machine text produced by core/measure and must read identically on every machine, because
         they are pasted into bug reports. -->
    <string name="mirror_measure_title">Measuring</string>
    <string name="mirror_measure_row_size">Size</string>
    <string name="mirror_measure_row_top">Top</string>
    <string name="mirror_measure_row_right">Right</string>
    <string name="mirror_measure_row_bottom">Bottom</string>
    <string name="mirror_measure_row_left">Left</string>
    <!-- The design's own footer copy, verbatim. -->
    <string name="mirror_measure_footer">Numbers attach to the annotation and go into the prompt.</string>
    <!-- AC-72. The dump costs ~2.7 s, so the panel says so rather than silently reporting
         "View (no match)" for the whole of it. -->
    <string name="mirror_measure_hierarchy_dumping">Reading the view hierarchy… measurements are against the frame until it lands.</string>
    <!-- AC-69. "Unavailable" is not an error: every figure above is still measured, against the
         annotation box and the frame edges. -->
    <string name="mirror_measure_hierarchy_unavailable">No view hierarchy for this frame, so these are measured against the annotation box and the frame edges.</string>
    <!-- Machine state, like LIVE and FROZEN, but it has to be a string because the enum name is
         not what the design shows beside the spinner. -->
    <string name="mirror_status_dumping">DUMPING</string>
    <!-- Mirror - Payload tab (FR-46 / AC-13 / AC-77 / AC-79). Only the tab's CHROME is localised.
         The PROMPT label, the "≈ N tokens" estimate and the prompt body itself are machine text
         built by core/payload: they are pasted into Claude and into bug reports, so they must read
         identically on every machine. Same split as the measure panel above. -->
    <string name="mirror_payload_empty">Nothing staged. Draw a box and the payload builds here, exactly as Claude will get it.</string>
    <string name="mirror_payload_prompt_edit">Edit</string>
    <!-- A11Y: the 4-letter label alone does not say what is edited. -->
    <string name="mirror_payload_prompt_edit_description">Edit the prompt sent to Claude</string>
    <!-- Mirror - History tab (FR-26..FR-36 / AC-22 / AC-34 / AC-36 / AC-37). The meta line and
         the footer are the design's own copy, with the machine parts (counts, time, short batch
         id, session id) interpolated. The note count ships as two plain keys selected by a pure
         function: the repo has no <plurals> resource and this does not introduce the first one. -->
    <string name="mirror_history_empty">Nothing sent yet. Batches you send to Claude land here and survive a restart.</string>
    <string name="mirror_history_group_today">Today</string>
    <string name="mirror_history_group_yesterday">Yesterday</string>
    <string name="mirror_history_group_older">Older</string>
    <!-- note count * time sent * short batch id, e.g. "3 notes · 14:02 · #a41f". -->
    <string name="mirror_history_meta">%1$s · %2$s · #%3$s</string>
    <string name="mirror_history_meta_note_one">%1$d note</string>
    <string name="mirror_history_meta_note_other">%1$d notes</string>
    <!-- On every sent batch; opens the verify view. Disabled when the frame is not on disk. -->
    <string name="mirror_history_verify">Verify</string>
    <string name="mirror_history_status_sent">Sent</string>
    <string name="mirror_history_status_in_progress">In progress</string>
    <string name="mirror_history_status_fixed">Fixed</string>
    <string name="mirror_history_status_verified">Verified</string>
    <string name="mirror_history_status_followup">Follow-up sent</string>
    <!-- Agent and session line under the list, sourced from the newest batch. -->
    <string name="mirror_history_footer">claude · session %1$s</string>
    <!-- A11Y: the thumbnail is a crop of the annotated region of the reported screen. -->
    <string name="mirror_history_thumbnail_description">Screenshot of %1$s</string>
    <!-- Mirror - Verify view (FR-21 / AC-23 / AC-24 / AC-40 / AC-42 / AC-43). Only the CHROME is
         localised: the result line of each row is a measurement built by core/verify out of F-5's
         formatters (`top 6dp - 0dp`), machine data exactly like the measure panel's readout, and
         is never translated. The five error bodies are deliberately five different sentences -
         an aborted run that reads as one generic failure is indistinguishable from a verdict. -->
    <string name="mirror_verify_panel_title">Verification</string>
    <!-- Fixed count over the number of annotations verified, e.g. "2 of 3 fixed". -->
    <string name="mirror_verify_summary">%1$d of %2$d fixed</string>
    <!-- The verdict word in a result row; passed into VerificationRow.outcomeLabel. -->
    <string name="mirror_verify_outcome_fixed">Fixed</string>
    <string name="mirror_verify_outcome_still_off">Still off</string>
    <!-- Column captions over the two frames; the clock is appended by core/verify. -->
    <string name="mirror_verify_column_before">BEFORE</string>
    <string name="mirror_verify_column_after">AFTER</string>
    <!-- Footer actions. The count is the number of rows that are still off. -->
    <string name="mirror_verify_send_follow_up">Send follow-up · %1$d</string>
    <string name="mirror_verify_mark_all">Mark all as verified</string>
    <!-- The single exit from the verify view. -->
    <string name="mirror_verify_back_to_live">← Back to live</string>
    <!-- Progress steps. The recapture alone costs ~2.7 s, so the run says where it is. -->
    <string name="mirror_verify_phase_loading">Loading batch</string>
    <string name="mirror_verify_phase_recapturing">Recapturing</string>
    <string name="mirror_verify_phase_diffing">Diffing regions</string>
    <!-- One title and one body per VerifyError. Each names what went wrong and what to do. -->
    <string name="mirror_verify_error_no_live_session_title">Start mirroring first</string>
    <string name="mirror_verify_error_no_live_session_body">Nothing is streaming from %1$s, so there is no fresh frame to compare against. Start mirroring that device, then run Verify again.</string>
    <string name="mirror_verify_error_not_on_disk_title">This batch is no longer on disk</string>
    <string name="mirror_verify_error_not_on_disk_body">The frame stored for this batch cannot be read, so there is nothing to compare the device against. Batches whose files were removed cannot be verified.</string>
    <string name="mirror_verify_error_size_mismatch_title">The screen size changed</string>
    <string name="mirror_verify_error_size_mismatch_body">The stored frame and the live frame are different sizes, so every annotation would land somewhere else. Put the device back in the orientation and resolution it was captured in, then run Verify again.</string>
    <string name="mirror_verify_error_hierarchy_unusable_title">The view hierarchy does not match the frame</string>
    <string name="mirror_verify_error_hierarchy_unusable_body">The device reported its views in a different coordinate space from the frame, so every verdict would be confident and wrong. Turn off any display size override, then run Verify again.</string>
    <string name="mirror_verify_error_disconnected_title">The device went away</string>
    <string name="mirror_verify_error_disconnected_body">The connection dropped part way through, so nothing was verified and the status of this batch is unchanged. Reconnect the device, then run Verify again.</string>
</resources>
